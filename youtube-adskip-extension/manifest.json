{
  "manifest_version": 3,
  "name": "YouTube Ad-Skip Player",
  "version": "1.2.0",
  "description": "Automatically skips skippable ads, mutes during ads, logs non-skippable ads, and continues playlists on YouTube.",
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]

}



